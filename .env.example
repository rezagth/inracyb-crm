# Base Postgres (Neon recommandé) : URL de connexion « poolée », avec ?sslmode=require
DATABASE_URL=""
# Secret de signature des sessions : généré par `npm run setup` (ne jamais le partager)
AUTH_SECRET=""

# Lien avec StratCyber (facultatif) : URL du cockpit et secret partagé (le même que CRM_WEBHOOK_SECRET côté StratCyber)
STRATCYBER_URL=""
STRATCYBER_WEBHOOK_SECRET=""

# Envoi de mails depuis le CRM via Brevo (API transactionnelle, offre gratuite : 300 mails par jour)
# Clé : Brevo > SMTP et API > Clés API. L'expéditeur doit être validé et le domaine authentifié dans Brevo.
BREVO_API_KEY=""
MAIL_FROM_EMAIL="contact@infracyb.fr"
MAIL_FROM_NAME="InfraCyb"
# Adresse qui reçoit les réponses (par défaut : l'expéditeur)
MAIL_REPLY_TO=""
# Plafond d'envois par jour depuis le CRM (10 par défaut : prudence sur un domaine neuf)
MAIL_DAILY_LIMIT="10"
# Facultatif : plafond visé du service Diagnostic (10 par défaut, atteint par paliers) et repos entre deux services (30 jours)
# MAIL_DAILY_LIMIT_DIAGNOSTIC="10"
# Devis, factures et relances envoyés depuis le CRM (PDF joint). Adresse à valider dans Brevo (Expéditeurs).
# Vide : l'expéditeur ci-dessus. Les réponses vont vers l'e-mail de Paramètres. Hors plafond quotidien et hors pause de la prospection.
MAIL_BILLING_FROM_EMAIL=""
MAIL_BILLING_FROM_NAME=""
# CAMPAIGN_REST_DAYS="30"
# Campagne prescripteurs : plafond quotidien (10 par défaut). Courtiers (texte avec commission) : PRESCRIPTEUR_PARTENAIRES="1", après l'immatriculation.
# MAIL_DAILY_LIMIT_PRESCRIPTEUR="10"
# PRESCRIPTEUR_PARTENAIRES=""

# Recherche de prospects (facultatif) : téléphone et site web via Google Places (API « Places API (New) », facturation à activer).
# Sans cette clé, la recherche par Annuaire des Entreprises fonctionne quand même (gratuite, sans clé).
GOOGLE_PLACES_API_KEY=""

# Campagnes d'envoi en masse (page Campagnes)
# Adresse publique du CRM, en https:// : sert au lien de désinscription mis dans chaque mail (obligatoire pour envoyer)
APP_URL=
# Secret (16 caractères minimum) qui protège le déclenchement quotidien /api/cron/campagnes. Sur Vercel, Cron l'envoie automatiquement.
CRON_SECRET=

# Webhook Brevo (rebonds, plaintes spam, adresses invalides) : secret de 16 caractères minimum, à générer toi-même (ex. openssl rand -hex 16).
# Dans Brevo (Transactionnel > Paramètres > Webhooks), colle : https://<ton CRM>/api/webhooks/brevo?key=<ce secret>
BREVO_WEBHOOK_SECRET=

# Lecture automatique des réponses aux campagnes (Gmail, lecture seule). Facultatif : sans ces trois variables, le bouton « Réponse reçue » reste disponible.
# Voir DEPLOIEMENT.md, section « Lecture automatique des réponses ».
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Destinataire du rapport hebdomadaire (lundi 7h15 UTC). Vide : e-mail du profil du CRM.
REPORT_TO_EMAIL=
