# Base Postgres (Neon recommandé) : URL de connexion « poolée », avec ?sslmode=require
DATABASE_URL=""
# Secret de signature des sessions : généré par `npm run setup` (ne jamais le partager)
AUTH_SECRET=""

# Lien avec StratCyber (facultatif) : URL du cockpit et secret partagé (le même que CRM_WEBHOOK_SECRET côté StratCyber)
STRATCYBER_URL=""
STRATCYBER_WEBHOOK_SECRET=""

# Envoi de mails depuis le CRM via Brevo (API transactionnelle, offre gratuite : 300 mails par jour)
# Clé : Brevo > SMTP et API > Clés API. L'expéditeur doit être validé et le domaine authentifié dans Brevo.
BREVO_API_KEY=""
MAIL_FROM_EMAIL="contact@infracyb.fr"
MAIL_FROM_NAME="InfraCyb"
# Adresse qui reçoit les réponses (par défaut : l'expéditeur)
MAIL_REPLY_TO=""
# Plafond d'envois par jour depuis le CRM (10 par défaut : prudence sur un domaine neuf)
MAIL_DAILY_LIMIT="10"
